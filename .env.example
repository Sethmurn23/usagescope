# ============================================
# PRICING CONFIGURATION (Auto-Optimized)
# ============================================

# Subscription Price
APP_PRICE=19
APP_PRICE_ID=PRICE_NOT_CONFIGURED

# Trial Period (days)
TRIAL_DAYS=7

# Currency
CURRENCY=usd
BILLING_INTERVAL=month

# Pricing Strategy
# 📉 Conversion: Lower price, longer trial

# ============================================
# STRIPE CONFIGURATION
# ============================================

# ⚠️ BILLING IS NOT WIRED UP.
# No Stripe price was created because no valid STRIPE_SECRET_KEY was
# configured when this app was built (invalid key (Invalid API Key provided: sk_live_***********************wDJk)).
# APP_PRICE_ID is a placeholder, not a real Stripe price id — checkout will
# fail until a valid key is set and a real price is created.

STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PRICE_ID=PRICE_NOT_CONFIGURED

# DRY RUN - Set to false for live payments
DRY_RUN=true

# ============================================
# SUPABASE AUTH
# ============================================

SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key
